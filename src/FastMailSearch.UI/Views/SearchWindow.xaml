<Window x:Class="FastMailSearch.UI.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:FastMailSearch.UI.Helpers"
        mc:Ignorable="d"
        Title="FastMail Search" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#F1F1F1" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- TextBlock Default Style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>

        <!-- Dark TextBox Style -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="CaretBrush" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#2F6FED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2F6FED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#202124"/>
                                <Setter Property="Foreground" Value="#777777"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"/>

        <!-- ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353535"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Border x:Name="splitBorder"
                        HorizontalAlignment="Right"
                        Width="20"
                        BorderThickness="0"
                        SnapsToDevicePixels="True">
                    <Path x:Name="arrow"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#F1F1F1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#353535"/>
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#4A4A4A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#3D3D3D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="templateRoot" Property="Background" Value="#202124"/>
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#4A4A4A"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#777777"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="#2B2B2B"
                                        BorderBrush="#4A4A4A"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect"
                                                           Fill="{Binding Background, ElementName=dropDownBorder}"
                                                           Height="{Binding ActualHeight, ElementName=dropDownBorder}"
                                                           Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Grid.ColumnSpan="2"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="{TemplateBinding Padding}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#2F6FED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"/>

        <!-- Calendar Styles -->
        <Style x:Key="DarkCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Margin="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="NormalText"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353535"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F6FED"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353535"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                            <Grid.Resources>
                                <Style TargetType="Button" x:Key="CalendarHeaderButtonStyle">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#F1F1F1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="6,2" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#353535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="Button" x:Key="CalendarPrevButtonStyle">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Width" Value="24"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <Path Data="M 6 0 L 0 5 L 6 10 Z" Fill="#F1F1F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#353535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="Button" x:Key="CalendarNextButtonStyle">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Width" Value="24"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <Path Data="M 0 0 L 6 5 L 0 10 Z" Fill="#F1F1F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#353535"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Grid x:Name="PART_Chart">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource CalendarPrevButtonStyle}" Focusable="False"/>
                                    <Button x:Name="PART_HeaderButton" Grid.Row="0" Grid.Column="1"
                                            Style="{StaticResource CalendarHeaderButtonStyle}" HorizontalAlignment="Center"/>
                                    <Button x:Name="PART_NextButton" Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource CalendarNextButtonStyle}" Focusable="False"/>
                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Visible" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Hidden" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButtonStyle}"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource DarkCalendarItemStyle}"/>
        </Style>

        <Style TargetType="Calendar" BasedOn="{StaticResource DarkCalendarStyle}"/>

        <!-- DatePicker TextBox Style -->
        <Style x:Key="DarkDatePickerTextBoxStyle" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="CaretBrush" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#2F6FED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4,0,0,4"
                                    Padding="{TemplateBinding Padding}">
                                <Grid x:Name="WatermarkContent">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                    <ContentControl x:Name="PART_Watermark"
                                                    Content="{TemplateBinding Text}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    Foreground="#B8B8B8"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2F6FED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker Calendar Button Style -->
        <Style x:Key="DarkDatePickerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,4,4,0"
                                SnapsToDevicePixels="True">
                            <Path x:Name="icon"
                                  Data="M 3 2 C 2.448 2 2 2.448 2 3 L 2 13 C 2 13.552 2.448 14 3 14 L 13 14 C 13.552 14 14 13.552 14 13 L 14 3 C 14 2.448 13.552 2 13 2 L 3 2 z M 4 4 L 12 4 L 12 5 L 4 5 L 4 4 z M 4 7 L 6 7 L 6 9 L 4 9 L 4 7 z M 7 7 L 9 7 L 9 9 L 7 9 L 7 7 z M 10 7 L 12 7 L 12 9 L 10 9 L 10 7 z M 4 10 L 6 10 L 6 12 L 4 12 L 4 10 z M 7 10 L 9 10 L 9 12 L 7 12 L 7 10 z M 10 10 L 12 10 L 12 12 L 10 12 L 10 10 z"
                                  Fill="#F1F1F1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353535"/>
                                <Setter TargetName="icon" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#202124"/>
                                <Setter TargetName="icon" Property="Fill" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DatePicker Style -->
        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Background="{TemplateBinding Background}"
                                               Foreground="{TemplateBinding Foreground}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="1,1,0,1"
                                               Focusable="{TemplateBinding Focusable}"
                                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Padding="6,4"
                                               Style="{StaticResource DarkDatePickerTextBoxStyle}"/>
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Style="{StaticResource DarkDatePickerButtonStyle}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False">
                                <Calendar x:Name="PART_Calendar"
                                          Style="{TemplateBinding CalendarStyle}"/>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker" BasedOn="{StaticResource DarkDatePickerStyle}"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B7AF5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2459C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#202124"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#202124"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Search Bar (Row 0) -->
            <RowDefinition Height="Auto"/> <!-- Filter Panel (Row 1) -->
            <RowDefinition Height="Auto"/> <!-- Invalid Syntax Banner (Row 2) -->
            <RowDefinition Height="*"/>    <!-- Results Area (Row 3) -->
            <RowDefinition Height="Auto"/> <!-- Summary Bar (Row 4) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar (Row 5) -->
        </Grid.RowDefinitions>

        <!-- Top Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Padding="10,8,30,8" Height="40">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        <KeyBinding Key="Esc" Command="{Binding ClearFiltersCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <!-- Clear X Button -->
                <Button Command="{Binding ClearFiltersCommand}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="24" Margin="0,0,6,0" Style="{StaticResource IconButtonStyle}"
                        Padding="0" FontSize="14" ToolTip="Clear Search (Esc)"/>
            </Grid>

            <!-- Search History Dropdown -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding SearchHistoryList}" SelectedItem="{Binding SelectedSearchHistory, Mode=TwoWay}"
                      Width="32" Height="40" Margin="0,0,8,0" ToolTip="Recent Searches"/>

            <!-- Sort Option Dropdown -->
            <ComboBox Grid.Column="2" ItemsSource="{Binding SortOrderOptions}" SelectedItem="{Binding SelectedSortOption}"
                      Width="130" Height="40" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Sort Results"/>

            <Button Grid.Column="3" Command="{Binding SearchCommand}" Content="Search" Width="100" Height="40" FontSize="14"/>

            <Button Grid.Column="4" Click="OpenDiagnostics_Click" Content="⚙️ Diagnostics" Width="120" Height="40" FontSize="13" Margin="8,0,0,0" Style="{StaticResource ClearButtonStyle}" ToolTip="Help &amp; Diagnostics"/>
        </Grid>

        <!-- Filters Panel -->
        <Border Grid.Row="1" Background="#202124" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#4A4A4A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- From -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="From" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FromFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </StackPanel>

                    <!-- To -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="To / Cc" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ToFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </StackPanel>

                    <!-- Subject -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Subject" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SubjectFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </StackPanel>

                    <!-- Folder -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Folder" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolder}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date From -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Date From" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DateFrom}"/>
                    </StackPanel>

                    <!-- Date To -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Date To" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DateTo}"/>
                    </StackPanel>

                    <!-- Attachments -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Attachments" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AttachmentOptions}" SelectedItem="{Binding SelectedAttachmentOption}"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding SearchCommand}" Content="Apply" Margin="0,0,6,0" Padding="12,5"/>
                        <Button Command="{Binding ClearFiltersCommand}" Content="Clear" Style="{StaticResource ClearButtonStyle}" Padding="12,5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Banners Panel -->
        <StackPanel Grid.Row="2">
            <!-- Trial Warning Banner -->
            <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding IsTrialWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ Unregistered: " Foreground="#60A5FA" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TrialDaysRemainingText}" Foreground="#93C5FD"/>
                </StackPanel>
            </Border>

            <!-- Invalid Syntax Banner -->
            <Border Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding IsInvalidSyntax, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ Invalid search syntax: " Foreground="#EF4444" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SyntaxErrorMessage}" Foreground="#FCA5A5"/>
                </StackPanel>
            </Border>

            <!-- Safe Mode Banner -->
            <Border Background="#3F2D00" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding IsSafeMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ Safe Mode Active: " Foreground="#F59E0B" FontWeight="Bold"/>
                    <TextBlock Text="FastMail Search started in Safe Mode. Outlook functionality is unaffected." Foreground="#FCD34D"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Results List (Virtualized) -->
        <ListView x:Name="ResultsListView" Grid.Row="3" ItemsSource="{Binding SearchResults}" Background="#18181B" BorderBrush="#4A4A4A"
                  ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="0,0,0,8">
            <ListView.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding OpenResultCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem}" />
                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySearchResultCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem}" />
                <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
                <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
                <KeyBinding Key="Home" Command="{Binding FirstPageCommand}" />
                <KeyBinding Key="End" Command="{Binding LastPageCommand}" />
            </ListView.InputBindings>
            <ListView.ContextMenu>
                <ContextMenu Background="#202124" Foreground="#F1F1F1" BorderBrush="#4A4A4A">
                    <MenuItem Header="Open Email" Command="{Binding OpenResultCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                    <Separator Background="#4A4A4A"/>
                    <MenuItem Header="Copy Subject" Command="{Binding CopySubjectCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                    <MenuItem Header="Copy Sender" Command="{Binding CopySenderCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                    <MenuItem Header="Copy Email Address" Command="{Binding CopyEmailAddressCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                    <MenuItem Header="Copy Entry ID" Command="{Binding CopyEntryIdCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                    <Separator Background="#4A4A4A"/>
                    <MenuItem Header="Copy Search Result" Command="{Binding CopySearchResultCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Background" Value="#202124"/>
                    <Setter Property="BorderBrush" Value="#4A4A4A"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="ItemGrid">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}"/>
                        </Grid.InputBindings>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1: Subject, Sender, Indicators -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock helpers:TextBlockExtensions.HighlightText="{Binding Subject}"
                                           helpers:TextBlockExtensions.QueryText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           FontWeight="Bold" FontSize="14" Foreground="#60A5FA" Margin="0,0,10,0"/>
                                <TextBlock helpers:TextBlockExtensions.HighlightText="{Binding DisplaySender}"
                                           helpers:TextBlockExtensions.QueryText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           FontSize="12" Foreground="#B8B8B8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding AttachmentIcon}" Margin="0,0,6,0" ToolTip="Has Attachment"/>
                                <TextBlock Text="{Binding FlagIcon}" Margin="0,0,6,0" Foreground="#EF4444"/>
                                <TextBlock Text="{Binding ImportanceIcon}" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Date & Folder -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,4">
                            <TextBlock Text="{Binding DisplayDate}" FontSize="11" Foreground="#B8B8B8" Margin="0,0,12,0"/>
                            <TextBlock Text="📁 " FontSize="11"/>
                            <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="#B8B8B8"/>
                        </StackPanel>

                        <!-- Row 3: Body Snippet -->
                        <TextBlock Grid.Row="2" helpers:TextBlockExtensions.HighlightText="{Binding BodySnippet}"
                                   helpers:TextBlockExtensions.QueryText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                   FontSize="12" Foreground="#D4D4D8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Summary & Pagination Bar -->
        <Grid Grid.Row="4" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Results Count & Range -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ResultsSummaryText}" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ShowingResultsSummaryText}" FontSize="12" Foreground="#B8B8B8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Navigation & Page Size Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding FirstPageCommand}" Content="⏮" ToolTip="First Page"
                        Style="{StaticResource ClearButtonStyle}" Padding="6,3" Margin="0,0,4,0" FontSize="11"/>
                <Button Command="{Binding PreviousPageCommand}" Content="◀" ToolTip="Previous Page"
                        Style="{StaticResource ClearButtonStyle}" Padding="6,3" Margin="0,0,8,0" FontSize="11"/>
                
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#F1F1F1" Margin="0,0,4,0">
                    <Run Text="Page "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <Button Command="{Binding NextPageCommand}" Content="▶" ToolTip="Next Page"
                        Style="{StaticResource ClearButtonStyle}" Padding="6,3" Margin="8,0,4,0" FontSize="11"/>
                <Button Command="{Binding LastPageCommand}" Content="⏭" ToolTip="Last Page"
                        Style="{StaticResource ClearButtonStyle}" Padding="6,3" Margin="0,0,12,0" FontSize="11"/>

                <!-- Page Size Selector -->
                <TextBlock Text="Page size:" VerticalAlignment="Center" FontSize="11" Foreground="#B8B8B8" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}"
                          Width="60" Height="26" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding SearchTimeText}" FontSize="12" Foreground="#B8B8B8" VerticalAlignment="Center"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="#202124" Padding="10,6" CornerRadius="4" BorderBrush="#4A4A4A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="#B8B8B8" FontSize="12"/>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="#4ADE80" FontSize="12" Margin="0,0,12,0"/>
                    <ProgressBar Minimum="0" Maximum="{Binding IndexTotalItems}" Value="{Binding IndexProcessedItems}"
                                 IsIndeterminate="False" Width="140" Height="10"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="OpenIndexHealth_Click" Content="Index Health" Style="{StaticResource ClearButtonStyle}" FontSize="11" Padding="8,3" Margin="0,0,6,0"/>
                    <Button Command="{Binding RebuildIndexCommand}" Content="{Binding RebuildButtonText}" IsEnabled="{Binding CanRebuildIndex}" Style="{StaticResource ClearButtonStyle}" FontSize="11" Padding="8,3"/>
                    <Button Command="{Binding CancelIndexCommand}" Content="Cancel Index" Background="#EF4444" Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" Padding="8,3" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activation Overlay -->
        <Grid Grid.RowSpan="6" Background="#DD000000" Visibility="{Binding IsActivationOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#202124" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="8" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Trial Expired" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your 30-day trial of FastMail Search has expired. Please enter a valid license key to continue using the application." TextWrapping="Wrap" Foreground="#F1F1F1" Margin="0,0,0,16" TextAlignment="Center" LineHeight="18"/>
                    
                    <!-- Hardware ID Display & Copy -->
                    <TextBlock Text="Your Hardware ID:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HardwareId, Mode=OneWay}" IsReadOnly="True" 
                                 FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="#38BDF8" Background="#18181B" BorderBrush="#3F3F46" 
                                 Padding="8,6" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CopyHardwareIdCommand}" 
                                Content="Copy ID" Style="{StaticResource ClearButtonStyle}" 
                                Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Copy Hardware ID to clipboard"/>
                    </Grid>
                    <TextBlock Text="{Binding CopyHardwareIdStatusMessage}" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,12"/>

                    <!-- License Key Input -->
                    <TextBlock Text="License Key:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" Margin="0,0,0,8" />
                    
                    <TextBlock Text="{Binding ActivationErrorMessage}" Foreground="#EF4444" Margin="0,0,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    
                    <!-- Action Buttons -->
                    <Button Command="{Binding ActivateCommand}" Content="Activate Now" Width="160" Height="40" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    
                    <!-- Help & Diagnostics -->
                    <Button Click="OpenDiagnostics_Click" Content="⚙️ Help &amp; Diagnostics" Style="{StaticResource ClearButtonStyle}" Width="160" Height="34" Margin="0,10,0,0" HorizontalAlignment="Center" ToolTip="Open system diagnostics, health status, and support logs"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

