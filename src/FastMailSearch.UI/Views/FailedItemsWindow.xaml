<Window x:Class="FastMailSearch.UI.Views.FailedItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMail Search - Failed Index Items Administration" Height="500" Width="800"
        WindowStartupLocation="CenterOwner" Background="#18181B" Foreground="#F4F4F5" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="FASTMAIL SEARCH" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
            <TextBlock Text="FAILED INDEX ITEMS" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Command="{Binding SelectAllCommand}" Content="Select All" Margin="0,0,8,0" Padding="10,5" Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46"/>
            <Button Command="{Binding RetrySelectedCommand}" Content="Retry Selected" Margin="0,0,8,0" Padding="10,5" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0369A1" FontWeight="Bold"/>
            <Button Command="{Binding RemoveSelectedCommand}" Content="Remove Selected" Margin="0,0,8,0" Padding="10,5" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"/>
            <Button Command="{Binding RetryAllCommand}" Content="Retry All Failed" Margin="0,0,8,0" Padding="10,5" Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46"/>
            <Button Command="{Binding ClearAllCommand}" Content="Clear All Failed" Margin="0,0,8,0" Padding="10,5" Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="#27272A" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1">
            <DataGrid x:Name="FailedDataGrid" ItemsSource="{Binding FailedItems}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended"
                      Background="#27272A" RowBackground="#18181B" AlternatingRowBackground="#27272A"
                      Foreground="#F4F4F5" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46"
                      BorderThickness="0" HeadersVisibility="Column">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#18181B"/>
                        <Setter Property="Foreground" Value="#A1A1AA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ContextMenu>
                    <ContextMenu Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46">
                        <MenuItem Header="Retry Selected" Command="{Binding RetrySelectedCommand}"/>
                        <MenuItem Header="Remove Selected" Command="{Binding RemoveSelectedCommand}"/>
                        <Separator Background="#3F3F46"/>
                        <MenuItem Header="Copy Entry ID" Click="CopyEntryId_Click"/>
                        <MenuItem Header="Copy Error" Click="CopyError_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="80"/>
                    <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="120"/>
                    <DataGridTextColumn Header="Operation" Binding="{Binding OperationType}" Width="90"/>
                    <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="70"/>
                    <DataGridTextColumn Header="Last Failed" Binding="{Binding DisplayLastFailed}" Width="150"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding ShortError}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A1A1AA" VerticalAlignment="Center"/>
            <Button Click="CloseButton_Click" Content="Close" HorizontalAlignment="Right" Padding="16,6" Background="#3F3F46" Foreground="#F4F4F5"/>
        </Grid>
    </Grid>
</Window>
