<Window x:Class="FastMailSearch.UI.Views.IndexHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMail Search - Index Health &amp; Recovery Center" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" Background="#18181B" Foreground="#F4F4F5" ResizeMode="CanMinimize" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">
    <Window.Resources>
        <Style x:Key="GreenActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22C55E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#16A34A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15803D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#14532D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#143820"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1C4D2C"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#202124"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#075985"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#162D42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#52525B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#71717A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#202124"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="FASTMAIL SEARCH" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
            <TextBlock Text="INDEX HEALTH &amp; RECOVERY CENTER" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#27272A" Padding="16" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="Bold" Margin="0,0,0,12" FontSize="13"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Summary.StatusState}" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Indexed Emails:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.IndexedEmailCount, StringFormat='{}{0:N0} emails'}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mailbox Coverage:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.DisplayCoverage}" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pending Queue:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.PendingQueueCount, StringFormat='{}{0:N0} items'}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Failed Queue:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.FailedItemCount, StringFormat='{}{0:N0} items'}" Foreground="#F87171"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Update:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.DisplayLastUpdate}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Database Size:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Summary.DisplayDbSize}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Last Error:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Summary.DisplayLastError}" TextWrapping="Wrap" Foreground="#A1A1AA"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Integrity Details:" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#FACC15" Margin="0,4,0,0"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
                <Button Command="{Binding BackfillStoreCommand}" Content="Backfill Outlook" Style="{StaticResource GreenActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Command="{Binding VerifyIndexCommand}" Content="Verify Index" Style="{StaticResource DarkActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Command="{Binding RetryFailedCommand}" Content="Retry Failed" Style="{StaticResource DarkActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Command="{Binding ViewFailedCommand}" Content="View Failed" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,8,0"/>
            </WrapPanel>

            <Button Grid.Column="1" Click="CloseButton_Click" Content="Close" Style="{StaticResource CloseActionButtonStyle}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
