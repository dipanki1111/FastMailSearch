<Window x:Class="FastMailSearch.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMail Search — Help &amp; Diagnostics" Height="520" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F1F1F1" ResizeMode="CanMinimize" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Help &amp; Diagnostics" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            <TextBlock Text="System status, database health verification and technical diagnostic tools." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="#27272A" BorderBrush="#3F3F46" Foreground="#F1F1F1">
            <!-- Tab 1: Indexer Status -->
            <TabItem Header="Indexer &amp; Safe Mode">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <!-- Safe Mode Warning Banner if active -->
                        <Border x:Name="SafeModeBanner" Background="#3F2D00" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ Safe Startup Mode Active" FontWeight="Bold" Foreground="#F59E0B" FontSize="14"/>
                                <TextBlock x:Name="SafeModeReasonText" Text="FastMail Search started in Safe Mode. Outlook functionality is unaffected." Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Progress Card -->
                        <Border x:Name="PnlLiveProgress" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Continuous Indexing Progress" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtProgressPercentage" Grid.Column="1" Text="0%" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                                </Grid>
                                <ProgressBar x:Name="PrgIndexing" Minimum="0" Maximum="100" Value="0" Height="8" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0"/>
                                <TextBlock x:Name="TxtProgressDetail" Text="Idle" FontSize="11" Foreground="#CBD5E1" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Indexer Health State:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtHealthState" Grid.Column="1" Text="🟢 Healthy" Foreground="#10B981" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current Operation:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtCurrentOp" Grid.Column="1" Text="Idle" Foreground="#F1F1F1"/>
                        </Grid>

                        <Separator Background="#3F3F46" Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Emails in Mailbox:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtDiscoveredCount" Grid.Column="1" Text="0" Foreground="#F8FAFC" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Successfully Indexed Emails:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtIndexedCount" Grid.Column="1" Text="0" Foreground="#10B981" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Emails Remaining to Scan:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtRemainingCount" Grid.Column="1" Text="0" Foreground="#F59E0B" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pending Queue Items:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtQueueLength" Grid.Column="1" Text="0" Foreground="#38BDF8"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Failed Items:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtFailedCount" Grid.Column="1" Text="0" Foreground="#A1A1AA"/>
                        </Grid>

                        <Separator Background="#3F3F46" Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mailbox Coverage:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtMailboxCoverage" Grid.Column="1" Text="Calculating..." Foreground="#38BDF8"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last Successful Indexing:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtLastIndexTime" Grid.Column="1" Text="N/A"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Database Health -->
            <TabItem Header="Database Health">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Database Path:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtDbPath" Grid.Column="1" Text="-" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Database Size:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtDbSize" Grid.Column="1" Text="0.00 MB"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SQLite Version:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtSqliteVer" Grid.Column="1" Text="3.x"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FTS5 Availability:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtFtsStatus" Grid.Column="1" Text="Available" Foreground="#10B981"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Integrity Check:" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtIntegrity" Grid.Column="1" Text="Passed" Foreground="#10B981"/>
                        </Grid>

                        <Button Content="🔧 Repair Search Index" Click="BtnRepairIndex_Click" Width="180" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="8,6" Background="#3F3F46" Foreground="#F1F1F1" BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Environment & Export -->
            <TabItem Header="Environment &amp; Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Environment Information" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtEnvInfo" Text="Detecting..." TextWrapping="Wrap" Foreground="#D4D4D8" FontFamily="Consolas" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="📦 Export Diagnostics ZIP" Click="BtnExportZip_Click" Padding="12,6" Background="#2F6FED" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,12,0"/>
                            <Button Content="📁 Open Logs Folder" Click="BtnOpenLogs_Click" Padding="12,6" Background="#3F3F46" Foreground="#F1F1F1" BorderThickness="0"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkBetaMode" Content="Enable Beta Diagnostic Logging (Extra timing counters, zero PII)" Checked="ChkBetaMode_Changed" Unchecked="ChkBetaMode_Changed" Foreground="#F1F1F1" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: About -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="FastMail Search" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Fast, Local Search for Classic Outlook" FontSize="13" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                        <Border Background="#202124" CornerRadius="6" Padding="16" BorderBrush="#374151" BorderThickness="1" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock x:Name="TxtAboutVersion" Grid.Row="0" Grid.Column="1" Text="1.0.7" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock x:Name="TxtAboutBitness" Grid.Row="1" Grid.Column="1" Text="x64 / x86" Foreground="#F3F4F6" Margin="0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SQLite Version:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock x:Name="TxtAboutSqliteVer" Grid.Row="2" Grid.Column="1" Text="3.45.1" Foreground="#F3F4F6" Margin="0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="FTS5 Engine:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Available (Full-Text Search Enabled)" Foreground="#10B981" FontWeight="SemiBold" Margin="0,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Database Version:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="v1.0 (FTS5 + Composite Key)" Foreground="#F3F4F6" Margin="0,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Indexer Version:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="1.0.7 (Safe Mode &amp; Incremental)" Foreground="#F3F4F6" Margin="0,3"/>
                            </Grid>
                        </Border>

                        <Button Content="Check for Updates" Click="BtnCheckUpdates_Click" HorizontalAlignment="Center" Width="180" Padding="10,6" Background="#374151" Foreground="#F3F4F6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Button Grid.Row="2" Content="Close" Click="BtnClose_Click" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="8,4" Background="#3F3F46" Foreground="#F1F1F1" BorderThickness="0"/>
    </Grid>
</Window>
