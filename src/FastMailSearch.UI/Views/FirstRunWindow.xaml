<Window x:Class="FastMailSearch.UI.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMail Search Setup" Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#181818" Foreground="#F1F1F1" ResizeMode="CanMinimize" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="FASTMAIL SEARCH" FontSize="22" FontWeight="Bold" Foreground="#3B82F6"/>
            <TextBlock Text="Fast, local search for Classic Outlook" FontSize="14" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="IntroPanel" Visibility="Visible">
                <Border Background="#202124" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Welcome to FastMail Search!" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6" Margin="0,0,0,8"/>
                        <TextBlock Text="FastMail Search provides instant, full-text local search for Classic Microsoft Outlook with zero impact on your email transport pipeline." TextWrapping="Wrap" Foreground="#D1D5DB" FontSize="13" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="8,0,8,16">
                    <TextBlock Text="Key Features &amp; Principles:" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6" Margin="0,0,0,10"/>
                    <BulletDecorator Margin="0,0,0,6">
                        <TextBlock Text="• Search is performed entirely against your local SQLite/FTS5 index." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="13"/>
                    </BulletDecorator>
                    <BulletDecorator Margin="0,0,0,6">
                        <TextBlock Text="• All email indexing happens locally on your computer." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="13"/>
                    </BulletDecorator>
                    <BulletDecorator Margin="0,0,0,6">
                        <TextBlock Text="• FastMail Search NEVER intercepts or modifies outgoing emails." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="13"/>
                    </BulletDecorator>
                    <BulletDecorator Margin="0,0,0,6">
                        <TextBlock Text="• Background indexing processes messages non-intrusively." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="13"/>
                    </BulletDecorator>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Indexing Status Panel (Shown during initial setup indexing) -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed">
            <Border Background="#202124" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
                <StackPanel x:Name="StatusDetailsStack">
                    <TextBlock x:Name="TxtStatus" Text="Initializing local indexer..." FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="ProgressInitial" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#3B82F6" Background="#374151" Margin="0,4,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtMailboxes" Text="Mailboxes: Discovered" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtFolders" Text="Folders: Scanning..." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtCount" Text="Emails: 0 discovered" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtCurrentFolder" Text="Folder: -" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPause" Content="Pause" Click="BtnPause_Click" Visibility="Collapsed" Background="#374151" Padding="12,6"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnStartIndexing" Content="Start Indexing" Click="BtnStartIndexing_Click"/>
                <Button x:Name="BtnClose" Content="Close Setup" Click="BtnClose_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
