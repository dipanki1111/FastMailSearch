<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FastMailSearch.Setup</RootNamespace>
    <AssemblyName>FastMailSearch-v1.0.7-Store-Setup</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\FastMailSearch.UI\Resources\app.ico</ApplicationIcon>
    <StartupObject>FastMailSearch.Setup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <PropertyGroup>
    <PayloadZipPath Condition="'$(PayloadZipPath)' == ''">Payload.zip</PayloadZipPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZipPath)" Link="Payload.zip" Condition="Exists('$(PayloadZipPath)')" />
  </ItemGroup>
</Project>
