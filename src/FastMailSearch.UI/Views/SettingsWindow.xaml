<Window x:Class="FastMailSearch.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastMail Search Settings" Height="480" Width="600"
        WindowStartupLocation="CenterOwner" Background="#18181B" Foreground="#F4F4F5" Icon="pack://application:,,,/FastMailSearch.UI;component/Resources/app.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FastMail Search Settings" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <!-- DB Path -->
            <TextBlock Text="Database Path:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DatabasePath}" IsReadOnly="True" Background="#27272A" Foreground="#A1A1AA" Padding="6,4" Margin="0,0,0,12"/>

            <!-- Max Results -->
            <TextBlock Text="Maximum Results Returned:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox SelectedItem="{Binding MaxResults}" Margin="0,0,0,12">
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="250"/>
                <ComboBoxItem Content="500"/>
            </ComboBox>

            <!-- Toggles -->
            <CheckBox IsChecked="{Binding IndexOnStartup}" Content="Start indexing on Outlook launch" Foreground="#F4F4F5" Margin="0,0,0,8"/>
            <CheckBox IsChecked="{Binding BackgroundIndexing}" Content="Enable background incremental indexing" Foreground="#F4F4F5" Margin="0,0,0,16"/>

            <!-- Clear Search History -->
            <Button Command="{Binding ClearHistoryCommand}" Content="Clear Search History" Background="#3F3F46" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,20"/>

            <!-- Privacy Note -->
            <Border Background="#27272A" Padding="12" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1">
                <TextBlock Text="🔒 Privacy Notice: Your email index is stored strictly locally on this computer. No email data, metadata, or search history is ever transmitted to external servers or cloud services." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding SaveCommand}" Content="Save" Width="90" Margin="0,0,8,0"/>
            <Button Command="{Binding CloseCommand}" Content="Close" Background="#3F3F46" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
